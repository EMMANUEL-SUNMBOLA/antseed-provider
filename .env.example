# ============================================================================
# Antseed seller environment
#
#   Copy this file to:      /root/.antseed/.env      (on the VPS)
#   Load it before start:   set -a; source /root/.antseed/.env; set +a
#   NEVER commit the real .env (git-ignored).
# ============================================================================

# --- FUNDING ---------------------------------------------------------------
# Seller wallet created by `antseed seller setup` (secp256k1 key at
# ~/.antseed/identity.key). This is both the funding address AND the peer ID.
# Send ETH on BASE MAINNET here for gas. The seller stops advertising if the
# balance drops below 0.00005 ETH (~$0.10). $5 of ETH lasts a very long time.
# (This variable is a reference for humans/operators; the seller itself does
# not read it.)
ANTSEED_FUNDED_WALLET=0x5473831A3142d912FdF88495e17c08b2a6fc37Ec

# --- IDENTITY --------------------------------------------------------------
# Leave empty to use the default key file ~/.antseed/identity.key.
# If set (64 hex chars, no 0x), it takes precedence over the key file.
# Must control the SAME address as ANTSEED_FUNDED_WALLET above.
ANTSEED_IDENTITY_HEX=

# --- UPSTREAM CREDENTIALS --------------------------------------------------
# DeepSeek official API key: https://platform.deepseek.com  (API keys page)
# Referenced from config.json via provider field "apiKeyEnv": "DEEPSEEK_API_KEY".
# The openai plugin reads this env var at runtime; it is never stored in config.
DEEPSEEK_API_KEY=paste-your-deepseek-key-here

# --- OPTIONAL OVERRIDES ----------------------------------------------------
# ANTSEED_CONFIG=/root/.antseed/config.json
# ANTSEED_PASSPHRASE=                 # only if identity.key is encrypted
# ANTSEED_BASE_RPC_URL=               # your own Base RPC endpoint (production)
# ANTSEED_SETTLEMENT_IDLE_MS=600000   # default: settle after 10 min idle
