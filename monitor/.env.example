# antseed-monitor configuration (all optional — defaults work on this box).
# The bot token and admin ID are read at runtime from the existing services:
#   TGTOKEN        <- /root/workspace/FactCheck/.env          (reused retired bot)
#   ADMIN_CHAT_ID  <- /root/workspace/cavedl-tgbot/.env
# Put values here only to OVERRIDE those.

# TGTOKEN=123456:ABC...
# ADMIN_CHAT_ID=123456789

# Paths (override if the layout changes)
# FACTCHECK_ENV=/root/workspace/FactCheck/.env
# CAVEDL_ENV=/root/workspace/cavedl-tgbot/.env
# ANTSEED_BIN=/root/.nvm/versions/node/v24.14.1/bin/antseed
# ANTSEED_ENV_FILE=/root/.antseed/.env
# METERING_DB=/root/.antseed/metering.db

# Identity under watch
# ANTSEED_WALLET=0x5473831A3142d912FdF88495e17c08b2a6fc37Ec
# ANTSEED_PEER_ID=5473831A3142d912FdF88495e17c08b2a6fc37Ec
# PM2_NAME=antseed-seller

# Chain
# BASE_RPC=https://base.drpc.org
# USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# Monitoring thresholds
# CHECK_INTERVAL_MS=300000          # health poll every 5 min
# ACTIVITY_INTERVAL_MS=60000        # sales/failure DB poll every 1 min
# GAS_LOW_WEI=50000000000000        # 0.00005 ETH
# NO_SALES_WARN_HOURS=48            # warn if no served requests for this long
# ANOMALY_REQUESTS_PER_HOUR=100     # alert on spikes above this
# SALES_ALERTS=true                 # per-activity success/failure pushes
